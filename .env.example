# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable key (Project Settings → API → publishable key).
# Safe for public use; data access is governed by RLS policies.
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Database schema namespace (default: beary)
DB_SCHEMA=beary

# Admin credentials (login at /login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session encryption key (at least 32 characters)
SESSION_PASSWORD=super-secret-session-password-at-least-32-chars
